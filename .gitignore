# …but keep the Vite entry (the blanket *.html above would hide it → blank page)
!frontend/index.html

# …but keep package manifests (the blanket *.json above would hide them)
!frontend/package.json
!frontend/package-lock.json
!frontend/tsconfig*.json
!frontend/components.json

# …and the frontend source (the Python `lib/` rule above also hid src/lib)
!frontend/src/lib/
!frontend/src/lib/**

