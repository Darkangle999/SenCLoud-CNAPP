FROM python:3.11-slim

WORKDIR /app

# This is the small web/API image used by the single-host staging deployment.
# Trivy and Steampipe remain available in the full Dockerfile for dedicated
# scanner workers; they are deliberately excluded here to keep a t3.micro
# bootstrap feasible and avoid downloading large optional binaries on startup.
RUN groupadd --gid 10001 odineyes && useradd --uid 10001 --gid 10001 --create-home odineyes

# Trivy VM supports agentless vulnerability scanning of an existing private EBS
# snapshot through AWS EBS Direct APIs. The binary is version-pinned, verified
# against the upstream release checksum and self-pinned at runtime.
ARG TRIVY_VERSION=0.72.0
ARG TRIVY_SHA256=""
COPY scripts/install-trivy.sh /tmp/install-trivy.sh
RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends curl ca-certificates; \
    TRIVY_VERSION="${TRIVY_VERSION}" TRIVY_SHA256="${TRIVY_SHA256}" bash /tmp/install-trivy.sh; \
    apt-get purge -y --auto-remove curl; \
    rm -rf /var/lib/apt/lists/* /tmp/install-trivy.sh

COPY pyproject.toml requirements.txt ./
COPY src/ ./src/
COPY scanner-go/bin/odineyes-scanner-linux-amd64 /usr/local/bin/odineyes-scanner
COPY scanner-go/bin/odineyes-graph-linux-amd64 /usr/local/bin/odineyes-graph
COPY scanner-go/bin/odineyes-realtime-linux-amd64 /usr/local/bin/odineyes-realtime
RUN pip install --no-cache-dir -r requirements.txt && pip install --no-cache-dir -e ".[aws,db]"
RUN chmod 0555 /usr/local/bin/odineyes-scanner /usr/local/bin/odineyes-graph /usr/local/bin/odineyes-realtime
ENV PYTHONPATH=/app/src \
    PYTHONUNBUFFERED=1 \
    ODINEYES_TRIVY_SHA256_FILE=/etc/cloudsentinel/trivy.sha256

USER 10001:10001
EXPOSE 8000
CMD ["uvicorn", "odineyes.api.server:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
